# The local simulator runs without credentials. Copy to .env.local for Stage 5.
# Never commit real values. Use a separate database/user and Clerk instance per environment.
# Server-only — Stage 5
MONGODB_URI=
MONGODB_DB_NAME=pulsegrid_dev
CLERK_SECRET_KEY=
# Public by design — Stage 5. This is a publishable key, never a secret key.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Optional server-side comma-separated allowlist of exact app origins for Clerk.
# Set in Vercel to your actual deployment origins (no paths or wildcards).
CLERK_AUTHORIZED_PARTIES=
# Server-only — Stage 7
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Local Dev Server only: set to 1 locally; leave 0 on Vercel.
INNGEST_DEV=0
# Separate random server-only secret, at least 32 characters; keep stable across redeploys.
# Local Dev Server mode has a local-only fallback. Required for cloud acknowledgements.
WORKFLOW_RECEIPT_SECRET=
# Optional exact Inngest environment dashboard URL, e.g. https://app.inngest.com/env/production
WORKFLOW_DASHBOARD_URL=
# Server-only — optional protected-preview CI smoke tests, stored in GitHub Secrets.
# Do not put this key in a NEXT_PUBLIC_* variable.
VERCEL_AUTOMATION_BYPASS_SECRET=

# Stage 9: server-only; generate VAPID once with npm exec web-push generate-vapid-keys.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A real operator contact URI (mailto: or https:). No audience email collection.
VAPID_SUBJECT=
# Stable 32-byte random hex key for AES-256-GCM subscriptions; never NEXT_PUBLIC_.
DONOR_PUSH_ENCRYPTION_KEY=

# Stage 10: register the daily 02:00 IST forecast/proposal cron only in the
# dedicated demo environment after checking the shared account quota dashboard.
# The manual pulsegrid/forecast.requested event remains available for rehearsal.
FORECAST_JOBS_ENABLED=0

# Stage 11: stable random 32-byte HEX HMAC key. Generate once, keep server-only.
# Required for seeding, inventory writes and signature verification. No fallback.
AUDIT_HMAC_SECRET=
# Opt in after rehearsing schedules and checking account quotas.
AUDIT_JOBS_ENABLED=0
# Optional external publication. Fine-grained token: Contents write to ONE selected
# independent audit repository; pre-create the dedicated branch. Never NEXT_PUBLIC_.
AUDIT_GITHUB_ENABLED=0
GITHUB_ANCHOR_TOKEN=
GITHUB_ANCHOR_REPOSITORY=
GITHUB_ANCHOR_BRANCH=
# Optional operator email, sent only by the scheduled verifier on failure.
AUDIT_EMAIL_ENABLED=0
RESEND_API_KEY=
AUDIT_STAFF_EMAIL=
AUDIT_EMAIL_FROM=

# Stage 12: enable only in a dedicated synthetic demo environment.
DEMO_CONTROLS_ENABLED=0
# Server-only Vercel Global Config connection string (formerly Edge Config).
# Either variable works; GLOBAL_CONFIG takes precedence. Pre-create pulsegridChaos.
GLOBAL_CONFIG=
EDGE_CONFIG=
# Separate server-only Vercel API token scoped to the demo team; never NEXT_PUBLIC_.
DEMO_CONFIG_WRITE_TOKEN=
DEMO_CONFIG_TEAM_ID=

# Stage 14: dedicated synthetic bank environment only. Never real sensor input.
COLD_CHAIN_DEMO_ENABLED=0
# Optional server-only AI intake. No API call until enabled and a hospital signs in.
AI_INTAKE_ENABLED=0
OPENAI_API_KEY=
# Choose a Structured Outputs-capable model available in your account; no default.
OPENAI_INTAKE_MODEL=
