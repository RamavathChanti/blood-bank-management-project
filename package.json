{
  "name": "pulsegrid-college-demo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "surge:rehearse": "vitest run --config vitest.surge.config.mts",
    "test:workflow": "vitest run --config vitest.workflow.config.mts",
    "test:cache": "vitest run --config vitest.cache.config.mts",
    "workflow:dev": "inngest-cli dev -u http://localhost:3000/api/inngest",
    "registry": "tsc --strict --target es2022 --module commonjs --esModuleInterop --skipLibCheck --outDir .tools/registry scripts/registry.ts && node --conditions=react-server .tools/registry/scripts/registry.js",
    "registry:local-report": "tsc --strict --target es2022 --module commonjs --esModuleInterop --skipLibCheck --outDir .tools/registry-report scripts/registry-local-report.ts && node --conditions=react-server .tools/registry-report/scripts/registry-local-report.js",
    "test:e2e": "playwright test",
    "test:preview": "playwright test --config playwright.preview.config.ts",
    "simulation:report": "tsc --strict --target es2022 --module commonjs --skipLibCheck --outDir .tools/simulation-report scripts/simulation-report.ts && node .tools/simulation-report/scripts/simulation-report.js",
    "emergency:report": "tsc --strict --target es2022 --module commonjs --skipLibCheck --outDir .tools/emergency-report scripts/emergency-report.ts && node .tools/emergency-report/scripts/emergency-report.js",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "donor:keys": "node scripts/donor-keys.mjs",
    "resilience:rollback-local": "node scripts/rehearse-rollback.mjs",
    "waste:report": "tsc --strict --target es2022 --module commonjs --esModuleInterop --skipLibCheck --outDir .tools/waste-report scripts/waste-report.ts && node .tools/waste-report/scripts/waste-report.js",
    "submission:offline": "node scripts/build-offline.mjs",
    "submission:record": "node scripts/record-demo.mjs",
    "submission:documents": "python scripts/build-submission.py && node scripts/render-submission.mjs",
    "submission:package": "python scripts/package-submission.py"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.22",
    "@next/env": "16.4.3",
    "@react-three/fiber": "^9.8.2",
    "inngest": "4.26.1",
    "mongodb": "^7.7.0",
    "next": "16.4.3",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "three": "^0.186.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.3",
    "inngest-cli": "1.49.0",
    "mongodb-memory-server-core": "^11.3.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
